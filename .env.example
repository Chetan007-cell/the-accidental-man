# Local development: run `docker compose up -d db` and use this URL.
DATABASE_URL="postgresql://user:password@localhost:5432/accidental_man"
APP_URL=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XZ3NLG1Y0T

# Keep this key server-side. Verify the sender domain in Resend before sending.
RESEND_API_KEY=
